PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Exported Tide adapter JSON is public configuration and includes the embedded JWT verification key.
TIDECLOAK_ADAPTER_PATH=../client/public/tidecloak.json
DATABASE_PATH=./data/wellbeing.sqlite
# Local-only mock auth. Never enable in production or use real wellbeing data.
ENABLE_DEMO_AUTH=true
